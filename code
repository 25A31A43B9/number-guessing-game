#include <iostream>
#include <cstdlib>
#include <ctime>

using namespace std;

int main() {
    srand(time(0));
    int difficulty;
    cout << "Select difficulty:\n1. Easy (1-50)\n2. Medium (1-100)\n3. Hard (1-200)\nChoice: ";
    cin >> difficulty;

    int maxRange;
    if (difficulty == 1) maxRange = 50;
    else if (difficulty == 2) maxRange = 100;
    else maxRange = 200;

    int number = rand() % maxRange + 1;
    int guess, attempts = 0;

    cout << "Guess the number between 1 and " << maxRange << endl;

    do {
        cout << "Enter your guess: ";
        cin >> guess;
        attempts++;

        if (guess > number) cout << "Too high\n";
        else if (guess < number) cout << "Too low\n";
        else cout << "Correct! Attempts: " << attempts << endl;

    } while (guess != number);

    return 0;
}
